# ChromaDB Index (wird lokal gebaut, nicht versioniert)
chromadb_data/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Environment
.env
.env.local

# macOS
.DS_Store

# IDE
.idea/
.vscode/
